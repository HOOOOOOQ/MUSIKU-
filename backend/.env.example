# ─── MUSIKU+ Backend Environment ─────────────────────────────────────────────
# Copy to .env and fill real values. NEVER commit .env.
# Values marked "needs credentials" are NOT active until real keys are provided.

# MongoDB Atlas (REQUIRED — primary database)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/musiku_plus?retryWrites=true&w=majority
MONGODB_DB_NAME=musiku_plus
# Isolated database for the Atlas integration suite (CI sets musiku_plus_ci_test).
# Leave empty locally to use `<MONGODB_DB_NAME>_ci_test` automatically.
MONGODB_TEST_DB_NAME=
# Connection pooling / failover behaviour
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# JWT (REQUIRED — generate with: openssl rand -hex 32)
# Access and refresh tokens MUST use different keys; startup validation rejects
# identical values. JWT_SECRET also derives the AES-256-GCM key that encrypts
# provider credentials at rest, so rotating it requires re-entering those
# credentials through the admin dashboard.
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-openssl-rand-hex-32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
# Grace window in which a repeated presentation of an already-rotated refresh
# token is treated as a benign concurrent retry instead of token theft.
REFRESH_REUSE_GRACE_MS=30000

# Google OAuth — two different clients, two different jobs:
#   GOOGLE_CLIENT_ID     = Android OAuth client (package com.musikuplus.app + SHA-1).
#                          Identifies the app to Google Play services.
#   GOOGLE_WEB_CLIENT_ID = Web application OAuth client. This is the `aud` of the
#                          ID token that google_sign_in returns when serverClientId
#                          is set, so it is the audience the backend verifies.
# Neither value is a secret credential; both are public identifiers. The OAuth
# client SECRET is never needed for ID-token verification and must never be sent
# to Flutter.
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
# Reserved for a future server-side authorization-code flow (backend only).
GOOGLE_CLIENT_SECRET=
# Set to true ONLY if ID tokens are also issued directly for the Android client
# (i.e. the app does not pass serverClientId). Default: reject that audience.
GOOGLE_ACCEPT_ANDROID_AUDIENCE=false

# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:8080
ADMIN_URL=http://localhost:3001

# Redis (RESERVED — validated but not wired; provider cache/rate budgets are in-process)
REDIS_URL=

# Object storage for authorized media (NEEDS CREDENTIALS — e.g. Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Licensed music streaming provider (NEEDS CREDENTIALS — official licensed API)
LICENSED_MUSIC_API_KEY=
LICENSED_MUSIC_BASE_URL=

# Licensed anime streaming provider (NEEDS CREDENTIALS — official licensed API)
LICENSED_ANIME_API_KEY=
LICENSED_ANIME_BASE_URL=

# ─── Animeku (internal provider name: Animasu) ───────────────────────────────
# Catalog metadata for the Animeku tab. No API key is required; the base URL
# must be an https:// origin (startup validation rejects anything else).
ANIMASU_BASE_URL=https://api.nexadev.my.id/animasu
ANIMASU_ENABLED=true
# Playback authorization — READ THIS BEFORE ENABLING.
# A provider returning a video URL is NOT proof of distribution rights. Leave
# ANIMASU_STREAMING_AUTHORIZED=false unless you hold (or the provider grants)
# the rights to redistribute this media to your users. While false, the API
# serves metadata only and answers 403 STREAM_NOT_AUTHORIZED for media.
# Setting it to true REQUIRES a non-empty host allowlist; startup fails otherwise.
ANIMASU_STREAMING_AUTHORIZED=false
# Comma-separated https hosts that may serve resolved media, e.g.
#   ANIMASU_ALLOWED_STREAM_HOSTS=cdn.example.com,*.examplecdn.net
ANIMASU_ALLOWED_STREAM_HOSTS=
# Provider budget: request timeout, metadata cache TTL, requests per minute.
ANIMASU_TIMEOUT_MS=10000
ANIMASU_CACHE_TTL_SEC=900
ANIMASU_RATE_LIMIT_PER_MIN=60

# Payment provider (NEEDS CREDENTIALS — e.g. Stripe / Midtrans / Xendit)
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Email delivery (NEEDS CREDENTIALS — SMTP is the only implemented adapter)
# EMAIL_PROVIDER accepts only an empty value or `smtp`; anything else fails startup.
EMAIL_PROVIDER=
EMAIL_FROM=noreply@musikuplus.app

# Admin bootstrap (used by `npm run seed` to create the first admin user)
ADMIN_EMAIL=admin@musikuplus.app
ADMIN_PASSWORD=

# SMTP: port 587 requires STARTTLS; use SMTP_SECURE=true for 465
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_ACTION_URL=https://musikuplus.app/auth
# Stripe one-time premium access, not auto-renewal
PAYMENT_SUCCESS_URL=https://musikuplus.app/payment/success
PAYMENT_CANCEL_URL=https://musikuplus.app/payment/cancel

# Optional server-only fine-grained GitHub token with Actions:read for build status
GITHUB_BUILD_TOKEN=
