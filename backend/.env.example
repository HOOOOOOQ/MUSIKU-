# ─── MUSIKU+ Backend Environment ─────────────────────────────────────────────
# Copy to .env and fill real values. NEVER commit .env.
# Values marked "needs credentials" are NOT active until real keys are provided.

# MongoDB Atlas (REQUIRED — primary database)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/musiku_plus?retryWrites=true&w=majority
MONGODB_DB_NAME=musiku_plus

# JWT (REQUIRED — generate with: openssl rand -hex 32)
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-openssl-rand-hex-32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Google OAuth (NEEDS CREDENTIALS — Google Cloud Console > OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:8080
ADMIN_URL=http://localhost:3001

# Redis (RESERVED — validated but not wired; provider cache/rate budgets are in-process)
REDIS_URL=

# Object storage for authorized media (NEEDS CREDENTIALS — e.g. Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Licensed music streaming provider (NEEDS CREDENTIALS — official licensed API)
LICENSED_MUSIC_API_KEY=
LICENSED_MUSIC_BASE_URL=

# Licensed anime streaming provider (NEEDS CREDENTIALS — official licensed API)
LICENSED_ANIME_API_KEY=
LICENSED_ANIME_BASE_URL=

# Payment provider (NEEDS CREDENTIALS — e.g. Stripe / Midtrans / Xendit)
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Email delivery (NEEDS CREDENTIALS — SMTP is the only implemented adapter)
# EMAIL_PROVIDER accepts only an empty value or `smtp`; anything else fails startup.
EMAIL_PROVIDER=
EMAIL_FROM=noreply@musikuplus.app

# Admin bootstrap (used by `npm run seed` to create the first admin user)
ADMIN_EMAIL=admin@musikuplus.app
ADMIN_PASSWORD=

# SMTP: port 587 requires STARTTLS; use SMTP_SECURE=true for 465
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_ACTION_URL=https://musikuplus.app/auth
# Stripe one-time premium access, not auto-renewal
PAYMENT_SUCCESS_URL=https://musikuplus.app/payment/success
PAYMENT_CANCEL_URL=https://musikuplus.app/payment/cancel

# Optional server-only fine-grained GitHub token with Actions:read for build status
GITHUB_BUILD_TOKEN=
